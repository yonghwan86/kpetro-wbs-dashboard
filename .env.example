# MariaDB connection used by the native Windows setup
DB_HOST=127.0.0.1
DB_PORT=3303
DB_NAME=wbs_db
DB_USER=wbs_user
DB_PASSWORD=change-this-password

# Authentication and session security (replace every example secret)
SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=480
PUBLIC_DASHBOARD=true
INITIAL_ADMIN_ID=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-password
INITIAL_ADMIN_EMAIL=admin@example.invalid
CORS_ORIGINS=

# Flask development server
APP_HOST=127.0.0.1
APP_PORT=3000
FLASK_DEBUG=true

# Upload storage
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,hwp,hwpx,xls,xlsx,ppt,pptx,txt,png,jpg,jpeg

# Docker Compose only
DB_EXPOSE_PORT=3303
MARIADB_ROOT_PASSWORD=change-this-root-password
