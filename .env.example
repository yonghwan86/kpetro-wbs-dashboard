# MariaDB connection used by the native Windows setup
DB_HOST=127.0.0.1
DB_PORT=3303
DB_NAME=wbs_db
DB_USER=wbs_user
DB_PASSWORD=change-this-password

# Flask development server
APP_HOST=127.0.0.1
APP_PORT=3000
FLASK_DEBUG=true

# Upload storage
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=20

# Docker Compose only
DB_EXPOSE_PORT=3303
MARIADB_ROOT_PASSWORD=change-this-root-password
